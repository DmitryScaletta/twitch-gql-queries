{
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "pnpm oxfmt",
    "gen:typescript": "node scripts/typescript.ts",
    "readme": "node scripts/readme.ts",
    "openapi": "node scripts/openapi.ts --pack",
    "build": "pnpm gen:typescript && pnpm readme && pnpm openapi && pnpm fmt",
    "deploy": "pnpm swagger && surge docs twitch-gql-swagger.surge.sh",
    "serve": "pnpx serve docs"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "oxfmt": "^0.73.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.14.0"
}
